{% from "govuk/components/tag/macro.njk" import govukTag %}

<table class="govuk-table" data-module="moj-sortable-table" data-testid="mdt-main-table">
  <caption class="govuk-table__caption govuk-visually-hidden">Main testing list</caption>
  <thead class="govuk-table__head">
    <tr class="govuk-table__row">
      <th scope="col" class="govuk-table__header" aria-sort="none">Prisoner</th>
      <th scope="col" class="govuk-table__header" aria-sort="none">Original list</th>
      <th scope="col" class="govuk-table__header" aria-sort="none">Location</th>
      <th scope="col" class="govuk-table__header" aria-sort="none">Release date (CRD)</th>
      <th scope="col" class="govuk-table__header" aria-sort="none">Last selected month</th>
      <th scope="col" class="govuk-table__header" aria-sort="none">Status</th>
      <th scope="col" class="govuk-table__header">Action</th>
    </tr>
  </thead>
  <tbody class="govuk-table__body">
    {% for row in view.mainRows %}
      <tr class="govuk-table__row" data-entry-id="{{ row.entryId }}">
        <td class="govuk-table__cell">
          <div>{{ row.prisonerName }}</div>
          <div class="govuk-hint">{{ row.prisonerNumber }}</div>
        </td>
        <td class="govuk-table__cell">{{ row.originalList }}</td>
        <td class="govuk-table__cell">{{ row.location }}</td>
        <td class="govuk-table__cell">{{ row.releaseDate }}</td>
        <td class="govuk-table__cell">{{ row.lastSelectedMonth }}</td>
        <td class="govuk-table__cell">
          {% if row.status == "Not started" %}
            {{ govukTag({ text: row.status, classes: "govuk-tag--grey" }) }}
          {% elif row.status == "Sample taken" %}
            {{ govukTag({ text: row.status, classes: "govuk-tag--green" }) }}
          {% else %}
            {{ govukTag({ text: row.status, classes: "govuk-tag--red" }) }}
          {% endif %}
        </td>
        <td class="govuk-table__cell">
          {% if row.action.kind == "record-test" %}
            {% if view.permissions.level | hasPermission('MANAGE') %}
              <a href="{{ row.action.href }}" class="govuk-link" data-testid="mdt-action-record-test">Record test</a>
            {% else %}
              <span data-testid="mdt-action-no-action">No action needed</span>
            {% endif %}
          {% elif row.action.kind == "no-action" %}
            <span data-testid="mdt-action-no-action">No action needed</span>
          {% elif row.action.kind == "replaced-by-reserve" %}
            {% if row.action.href %}
              <a href="{{ row.action.href }}" target="_blank" rel="noopener noreferrer" class="govuk-link" data-testid="mdt-action-replaced">{{ row.action.text }}</a>
            {% else %}
              <span data-testid="mdt-action-replaced">{{ row.action.text }}</span>
            {% endif %}
          {% elif row.action.kind == "wait-for-previous-reserve" %}
            <span data-testid="mdt-action-wait-previous">Test previous reserve first</span>
          {% endif %}
        </td>
      </tr>
    {% endfor %}
  </tbody>
</table>

<nav class="moj-pagination" data-testid="mdt-main-pagination" aria-label="Main list pagination">
  <p class="govuk-body-s">Showing {{ view.mainRows | length }} row{% if view.mainRows | length != 1 %}s{% endif %}.</p>
</nav>
